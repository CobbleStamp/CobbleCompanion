{
  "binary": "/Users/keren/.local/bin/ibkr-cli",
  "description": "Live snapshot quote for a stock symbol (read-only, via the local Client Portal Gateway).",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "symbol": {
        "type": "string",
        "description": "Stock symbol to quote, e.g. AAPL."
      },
      "currency": {
        "type": "string",
        "description": "Contract currency. Defaults to USD."
      },
      "exchange": {
        "type": "string",
        "description": "Routing/listing exchange. Defaults to SMART."
      },
      "output": {
        "type": "string",
        "enum": ["json", "ndjson", "table"],
        "description": "Output framing. Defaults to json."
      }
    },
    "required": ["symbol"]
  },
  "argv": [
    "quote",
    "--currency={currency}",
    "--exchange={exchange}",
    "--output={output}",
    "--",
    "{symbol}"
  ],
  "limits": { "timeoutMs": 30000, "maxOutputBytes": 262144 }
}
