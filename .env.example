# =============================================================================
# CobbleCompanion — environment template
#
# ONE .env for the whole monorepo. Processes don't load it themselves (no dotenv
# in code); direnv exports it into your shell (.envrc → `dotenv_if_exists .env`),
# so everything you launch from the repo inherits it: the API (`pnpm dev`), DB
# migrations / CLI (`@cobble/db`), and the Discord worker (`@cobble/discord`).
#
# Segmented by the app that READS each variable:
#   • SHARED          — read by more than one app
#   • API             — packages/api
#   • DISCORD WORKER  — packages/discord (the always-on sibling process)
# The web client (packages/web) reads only VITE_* vars from its OWN
# packages/web/.env.local (Vite), not this file — see the note at the end.
# =============================================================================


# =============================================================================
# SHARED — cross-app variables
# =============================================================================

# --- Persistence ---
# Postgres connection (TLS required in production).
# Read by: the API, DB migrations + `@cobble/db` CLI, and the Discord worker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cobble

# --- Discord service client id (companion-discord.md §9) ---
# The id of the service credential the Discord worker uses to reach the API's
# token-mint endpoint. Read by BOTH apps from this one entry:
#   • the API     — enables + pins POST /internal/discord/token to this client;
#   • the worker  — authenticates to that endpoint as this client.
# The Discord surface is always-on: this ships with a fixed dev id and the API
# auto-seeds the matching service_registry row at boot from SERVICE_REGISTRY_SEEDS
# below (idempotent), so no manual `service add` is needed for local docker.
DISCORD_SERVICE_CLIENT_ID=discord-adapter

# --- Discord bot-token encryption key (companion-discord.md §9) ---
# SECRET — base64 of a 32-byte AES-256-GCM key. Read by BOTH apps:
#   • the API     — ENCRYPTS the bot token on write (the discord.config.* WS methods);
#   • the worker  — DECRYPTS the stored token to connect the bot.
# Must be the SAME key in both. This is a DEV-ONLY value committed for local docker;
# use a unique key per real deployment. Generate: openssl rand -base64 32
DISCORD_TOKEN_KEY=+9UycIW+oMRl7x2kp09uHRAZKuj0rcn5smE/mtAMeQk=


# =============================================================================
# API — packages/api (Fastify server; hosts /ws and the token-mint endpoint)
# =============================================================================

# --- LLM gateway ---
# Selects the gateway backend: openrouter | fake
LLM_PROVIDER=openrouter
# OpenRouter credential — secret, never commit a real value. Required when
# LLM_PROVIDER or EMBEDDING_PROVIDER is openrouter.
OPENROUTER_API_KEY=
# Model id passed to the provider.
LLM_MODEL=anthropic/claude-3.5-sonnet

# --- Embedding gateway (Phase 1, semantic memory) ---
# Selects the embedding backend: openrouter | fake
EMBEDDING_PROVIDER=openrouter
# Embedding model id passed to the provider.
EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b
# Embedding vector size — must equal the sections.embedding column dimension.
EMBEDDING_DIM=1024

# --- Ingestion (Phase 1, source reading) ---
# Cheap model for the two ingestion reading passes.
INGESTION_MODEL=google/gemini-2.5-flash
# Upload size cap for source files, in bytes (default 25 MiB).
INGESTION_MAX_BYTES=26214400
# A/B knob: prefix the Pass-2 context header onto embedding inputs (true | false).
USE_CONTEXT_HEADER=true
# Backstop cap on queued + in-flight ingestion runs across all owners.
INGESTION_QUEUE_MAX=100

# --- Upload staging (staging-object-storage.md) ---
# Where an upload's raw bytes live between accept and ingest. File uploads are a
# presigned, direct-to-backend flow (the client uploads the bytes, not the API).
#   s3   — production: bytes go straight to an S3 bucket; a bucket lifecycle rule
#          on the prefix owns expiry (TTL). Requires a bucket (+ region).
#   file — local/CI: bytes are written under a root directory; a periodic sweep
#          reclaims expired files. Requires UPLOAD_STAGING_FS_ROOT.
UPLOAD_STAGING_BACKEND=file
# Required when backend=file — directory the staged files are written under.
UPLOAD_STAGING_FS_ROOT=./data/upload-staging
# Required when backend=s3 — the bucket name; region falls back to AWS_REGION.
# UPLOAD_STAGING_S3_BUCKET=
# UPLOAD_STAGING_S3_REGION=
# Key prefix for staged objects (must match the bucket lifecycle rule's prefix).
UPLOAD_STAGING_PREFIX=tmp-uploads
# Slot/object TTL in ms (mirrors the S3 lifecycle expiry). Default 1 hour.
UPLOAD_STAGING_TTL_MS=3600000
# API origin the local (file backend) upload-slot URL points at; empty → derived
# from PORT. Set this if the browser reaches the API on a non-localhost origin.
# UPLOAD_STAGING_PUBLIC_BASE_URL=

# --- Realtime WebSocket (deliver-scalability.md §5.2) ---
# How often an open connection renews its embodiment claim (ms).
WS_HEARTBEAT_MS=10000
# Claim TTL: a claim with no heartbeat for this long is dead and reclaimable (ms).
WS_CLAIM_TTL_MS=30000
# Max bytes for a single inbound WS frame; an oversized frame is rejected at the
# transport (close 1009) before it is parsed. Default 256 KiB.
WS_MAX_PAYLOAD_BYTES=262144
# Max requests dispatched concurrently on one connection; past it a frame is shed
# with a `rate_limited` reply (per-connection load-shedding backstop).
WS_MAX_IN_FLIGHT=32
# Outbound backpressure ceiling, in bytes: past this many unsent bytes queued
# toward one client, the connection is closed as a slow/dead consumer (it then
# reconnects and resumes from its cursor — no events lost). Bounds the per-node
# memory a non-draining socket can consume. Default 8 MiB.
WS_MAX_BUFFERED_BYTES=8388608

# --- Background job queue (deliver-scalability.md §5.1) ---
# Claim lease a companion drain holds; renewed mid-drain by the heartbeat (ms).
# Must exceed JOB_HEARTBEAT_MS.
JOB_LEASE_MS=60000
# How often a running drain renews its claim (ms). Must be < JOB_LEASE_MS.
JOB_HEARTBEAT_MS=20000
# Coarse poll interval — the clock for idle/future-dated background work (ms).
JOB_POLL_INTERVAL_MS=30000
# Max concurrent companion drains per node.
JOB_CONCURRENCY=4

# --- Cost guardrail (Phase 1) ---
# Per-user daily token cap (LLM + embedding) across all routes.
TOKEN_CAP_PER_DAY=1000000

# --- MCP tool acquisition (Phase 9, docs/companion-tools.md §6) ---
# The developer's MCP server whitelist — the entire trust decision and a single,
# process-wide setting that applies to ALL users. A JSON array; empty (default)
# leaves runtime tool acquisition OFF, so behaviour is unchanged until you list a
# server. Read once at startup, so editing this requires an API restart to apply.
#
# Each entry: { ref, endpoint, label?, authTokenEnv? }
#   ref          Unique, non-empty alias the model connects by (connection rows
#                key on it). Duplicates fail fast at startup.
#   endpoint     The server's HTTP/SSE endpoint. Public http(s) only; it is
#                SSRF-validated, so loopback/private/internal hosts are rejected.
#   label        Optional human-friendly name shown on surfaces.
#   authTokenEnv Optional — the NAME of another env var holding the bearer token
#                (the token itself is never stored here; it is resolved per
#                connection from process.env). Set that var separately, below.
#
# Example (a single authenticated server; keep it one line, no spaces needed):
# MCP_SERVERS=[{"ref":"github","endpoint":"https://mcp.example.com/sse","label":"GitHub Tools","authTokenEnv":"GITHUB_MCP_TOKEN"}]
# GITHUB_MCP_TOKEN=
MCP_SERVERS=[]
# Max tools a companion carries equipped at once (companion-tools.md §4), only meaningful
# when MCP_SERVERS is non-empty. The companion discovers tools via search_tools and loads
# them on demand (reactively, or proactively from procedural memory); beyond this cap the
# least-recently-used equipped tool is unloaded, so per-turn context stays small no matter
# how large the whitelisted catalog is.
MAX_EQUIPPED_TOOLS=8

# --- CLI tool acquisition (Phase 10, companion-tools.md §6) ---
# Directory of CLI tool-definition folders — the CLI track's trust boundary.
# Each subfolder is one whitelisted tool: a TOOL.json (the machine contract:
# `binary`, a short `description`, the model-facing `parameters` JSON Schema, an
# `argv` template mapping validated params -> discrete argv elements, and a
# mandatory `limits` block) + a TOOL.md (the usage prompt shown once the tool is
# equipped). The
# model fills the schema; it never composes a free-form command.
#
# SECURITY: this directory must be READ-ONLY and deployment-controlled (a baked
# image or a read-only mount), and must NOT overlap any path the app writes to
# (uploads, ingestion temp, the CLI scratch dir). Anyone who can write here can
# admit a binary the companion will run. The named binary must be installed on the
# host image; dropping a folder defines how to drive it, it does not install it.
# Overlap with the CLI scratch dir (CLI_SCRATCH_DIR below, or the OS temp dir when
# it is unset) is rejected at startup — the app fails fast rather than boot unsafe.
#
# Empty (default) leaves the CLI track off. Example layout:
#   $CLI_TOOLS_PATH/imagemagick/TOOL.json
#   $CLI_TOOLS_PATH/imagemagick/TOOL.md
CLI_TOOLS_PATH=
# Root for the per-tenant EPHEMERAL working dirs CLI runs execute in (separate from
# CLI_TOOLS_PATH; cleaned up after each run). Empty -> the OS temp dir.
CLI_SCRATCH_DIR=
# Per-run resource ceilings (wall-clock + captured-output bytes) are declared
# per tool in each TOOL.json's mandatory "limits" block — there is no deployment
# default knob.

# --- Auth ---
# Auth is per-request, not a server-wide mode: app-session and service-token auth
# are ALWAYS live and a request is routed by the credentials it carries. A browser
# signs in with Google ONCE at POST /auth/session, which exchanges the Google ID
# token for the API's OWN short-lived access token (the per-request bearer) plus a
# refresh-token HttpOnly cookie; server-to-server consumers send service-token
# headers (see below).
#
# Required — the OAuth Web client ID (public, not a secret), the browser sign-in
# scheme. Create it in the Google Cloud Console (see infra/README.md) and add
# http://localhost:3001 as an authorized origin for local dev.
GOOGLE_CLIENT_ID=
# Required SECRET — the HS256 key the API signs its own session access/refresh tokens
# with (also used to mint the Discord worker's real-user access tokens; it never
# leaves the API). Must be >=32 bytes; NEVER commit a real value (supply via deployment
# env). Use a UNIQUE value per environment (staging != prod): tokens carry no iss/aud
# yet, so a shared secret would let one env's tokens authenticate against another.
# Generate: openssl rand -base64 48
JWT_SIGNING_SECRET=
# Optional session-token lifetimes (seconds). Access tokens are short (they ride the
# WS handshake URL and are refreshed on demand); the refresh token is the hard cap on
# a session before a Google re-authentication.
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_SEC=86400
# Service-token auth (always live) lets trusted server-to-server consumers call on
# behalf of their own users. Credentials live in the service_registry table. Add one with
#   pnpm --filter @cobble/db service add <client_id>
# or seed them on launch via SERVICE_REGISTRY_SEEDS (additive + idempotent), e.g.:
#   SERVICE_REGISTRY_SEEDS=[{"client_id":"sprout","secret":"<secret>","label":"seed"}]
# The Discord worker's credential is seeded here so the always-on surface works out
# of the box; the secret MUST match DISCORD_SERVICE_SECRET (dev-only value below).
SERVICE_REGISTRY_SEEDS=[{"client_id":"discord-adapter","secret":"zxqx2sSeGmEbTAUNjBVmwQHmE1Ke59vqvva4aBc6pbU","label":"discord"}]
# Callers then send X-Service-Client-Id + Authorization: Bearer <secret> + X-User-Id.
# Web client origin — allowed CORS origin for local cross-origin dev.
APP_URL=http://localhost:3001

# --- API server ---
# TCP port the Fastify API server binds on (host 0.0.0.0). This is the backend
# the web client (APP_URL) calls; keep it distinct from the web client's port.
PORT=3000

# --- Online tracing (Phase C) — OFF by default (docs/runbook-tracing.md) ---
# none (default) emits nothing; langfuse ships per-turn traces to Langfuse Cloud.
TRACING_PROVIDER=none
# Required when TRACING_PROVIDER=langfuse (secrets).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# HTTPS only (carries keys + payload); http permitted only for localhost.
LANGFUSE_HOST=https://cloud.langfuse.com
# Fraction of turns traced (0..1), deterministic per trace id. 0 = send nothing.
TRACING_SAMPLE_RATE=0
# strict (default, metadata only — no content) | metadata_only (same as strict
# today) | off (sends content with a defensive PII/secret scrub).
TRACING_REDACT=strict


# =============================================================================
# DISCORD WORKER — packages/discord (companion-discord.md, plans/discord-surface.md)
#
# The always-on sibling process that hosts users' Discord bots and bridges them
# to /ws. Run it with `pnpm --filter @cobble/discord dev`. It ALSO reads the two
# SHARED vars above: DATABASE_URL and DISCORD_SERVICE_CLIENT_ID.
# =============================================================================

# SECRET — the service credential's secret, paired with DISCORD_SERVICE_CLIENT_ID.
# The worker presents it to the token-mint endpoint. This is a DEV-ONLY value
# committed for local docker and MUST match the secret in SERVICE_REGISTRY_SEEDS
# above; use a unique secret per real deployment.
DISCORD_SERVICE_SECRET=zxqx2sSeGmEbTAUNjBVmwQHmE1Ke59vqvva4aBc6pbU
# (DISCORD_TOKEN_KEY is shared — see the SHARED segment above.)
# The API's WebSocket base origin the bridge connects to (no path). Local: ws://localhost:3000
DISCORD_WS_BASE_URL=ws://localhost:3000
# The API's internal token-mint endpoint URL. Local: http://localhost:3000/internal/discord/token
DISCORD_MINT_URL=http://localhost:3000/internal/discord/token
# How often the worker polls discord_config for token/config changes (ms, default 20000).
# DISCORD_POLL_INTERVAL_MS=20000


# =============================================================================
# WEB — packages/web (Vite SPA)
#
# The web client does NOT read this file. Its only build-time var, VITE_API_URL
# (the API origin the SPA calls), lives in packages/web/.env.local. It discovers
# GOOGLE_CLIENT_ID at runtime from the API's GET /auth/config, not from env.
# =============================================================================
